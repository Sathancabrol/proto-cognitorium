+def get_all_concepts():
+    return [
+        # ═══════════════════════════════════════
+        # BIAIS COGNITIFS (cat: "biais")
+        # ═══════════════════════════════════════
+        {"id":"b_confirmation","name":"Biais de confirmation","cat":"biais","tagline":"On ne voit que ce qu'on veut voir.","definition":"Tendance à rechercher, interpréter et mémoriser les informations qui confirment nos croyances préexistantes, tout en ignorant les preuves contraires.","auteur":"Wason (1960)","impact":"Renforce les opinions, alimente les chambres d'écho sur les réseaux sociaux, empêche la remise en question.","exemples":["Ne lire que les avis positifs d'un produit qu'on veut acheter","Un recruteur qui pose des questions confirmant sa première impression","Partager uniquement les articles qui vont dans notre sens"],"debiasing":["Rechercher activement des preuves contraires","Méthode de l'avocat du diable","Pré-enregistrement des hypothèses"]},
+        {"id":"b_ancrage","name":"Biais d'ancrage","cat":"biais","tagline":"Le premier chiffre piège tous les suivants.","definition":"Tendance à s'appuyer trop fortement sur la première information reçue (l'ancre) pour prendre des décisions, même si cette ancre est arbitraire.","auteur":"Tversky & Kahneman (1974)","impact":"Influence les négociations salariales, les prix, les estimations numériques. Le premier chiffre proposé sert de référence.","exemples":["Premier prix affiché dans une négociation","Estimation de population après avoir vu un grand nombre","Salaire demandé en premier dans un entretien"],"debiasing":["Considérer plusieurs ancres alternatives","Prendre du temps avant de décider","Utiliser des données objectives"]},
+        {"id":"b_disponibilite","name":"Biais de disponibilité","cat":"biais","tagline":"Ce qui frappe l'esprit semble plus fréquent.","definition":"Tendance à surestimer la probabilité d'événements facilement mémorables ou médiatisés.","auteur":"Tversky & Kahneman (1973)","impact":"Surestimation des risques spectaculaires (avion, terrorisme) vs sous-estimation des risques quotidiens (voiture, maladies cardiovasculaires).","exemples":["Peur de l'avion après un crash médiatisé","Croire que les enlèvements d'enfants augmentent à cause des médias","Surestimer la criminalité après un fait divers"],"debiasing":["Consulter les statistiques officielles","Distinguer fréquence médiatique et fréquence réelle"]},
+        {"id":"b_dunning_kruger","name":"Effet Dunning-Kruger","cat":"biais","tagline":"Moins on sait, plus on croit savoir.","definition":"Les personnes les moins compétentes dans un domaine surestiment leurs capacités, tandis que les experts les sous-estiment.","auteur":"Kruger & Dunning (1999)","impact":"Surconfiance des novices, sous-confiance des experts. Impact sur l'auto-évaluation en formation.","exemples":["Un débutant qui pense tout savoir après un tutoriel","Un expert qui doute de ses compétences","80% des conducteurs se jugent au-dessus de la moyenne"],"debiasing":["Formation continue et feedback externe","Comparer ses performances à des références objectives","Humilité épistémique"]},
+        {"id":"b_halo","name":"Effet de halo","cat":"biais","tagline":"Une qualité éclaire toutes les autres.","definition":"Une caractéristique positive (beauté, charisme) influence positivement le jugement de toutes les autres caractéristiques d'une personne.","auteur":"Thorndike (1920)","impact":"Biais en recrutement, évaluation scolaire, relations sociales. Les personnes attirantes sont jugées plus compétentes.","exemples":["Un candidat bien habillé jugé plus compétent","Un élève 'sympa' perçu comme plus intelligent","Un produit au beau packaging jugé de meilleure qualité"],"debiasing":["Évaluations anonymisées","Grilles critériées","Séparer les dimensions d'évaluation"]},
+        {"id":"b_framing","name":"Effet de cadrage","cat":"biais","tagline":"La façon de présenter change la décision.","definition":"La manière dont une information est présentée (gain vs perte) modifie significativement les décisions, même quand le contenu objectif est identique.","auteur":"Tversky & Kahneman (1981)","impact":"Marketing, communication politique, choix médicaux. Un même fait peut mener à des décisions opposées.","exemples":["'90% de réussite' vs '10% d'échec'","'Économie de 20€' vs 'Évite une perte de 20€'","Présentation de statistiques de santé"],"debiasing":["Reformuler le problème dans les deux cadres","Calculer les valeurs absolues"]},
+        {"id":"b_surconfiance","name":"Biais de surconfiance","cat":"biais","tagline":"On se croit meilleurs qu'on ne l'est.","definition":"Tendance systématique à surestimer ses propres capacités, connaissances ou la précision de ses jugements.","auteur":"Lichtenstein & Fischhoff (1977)","impact":"Décisions financières risquées, sous-estimation du temps nécessaire, calibration métacognitive défaillante.","exemples":["80% des conducteurs se jugent au-dessus de la moyenne","Prédire avec 90% de confiance mais avoir raison 50% du temps","Planning fallacy : toujours sous-estimer la durée"],"debiasing":["Calibration par feedback","Tenir un journal de prédictions","Pre-mortem : imaginer l'échec"]},
+        {"id":"b_statu_quo","name":"Biais du statu quo","cat":"biais","tagline":"On préfère ce qu'on connaît déjà.","definition":"Préférence irrationnelle pour le maintien de la situation actuelle, même quand le changement serait objectivement bénéfique.","auteur":"Samuelson & Zeckhauser (1988)","impact":"Inertie dans les choix de carrière, refus de changer de fournisseur, résistance au changement organisationnel.","exemples":["Garder son assurance par défaut","Rester dans un emploi insatisfaisant","Ne pas changer de banque malgré des offres meilleures"],"debiasing":["Évaluer activement les alternatives","Visualiser le coût de l'inaction"]},
+        {"id":"b_sunk_cost","name":"Biais des coûts irrécupérables","cat":"biais","tagline":"On persiste parce qu'on a déjà investi.","definition":"Tendance à continuer un investissement en raison des ressources déjà engagées, même quand l'abandon serait rationnel.","auteur":"Arkes & Blumer (1985)","impact":"Persistance dans des projets voués à l'échec, relations toxiques, carrières inadaptées.","exemples":["Finir un mauvais livre parce qu'on l'a commencé","Continuer un projet coûteux qui ne marche pas","Rester dans une filière inadaptée par peur de 'perdre' les années précédentes"],"debiasing":["Se demander : 'Si je recommençais à zéro, choisirais-je cette option ?'","Évaluer uniquement les coûts et bénéfices futurs"]},
+        {"id":"b_negativite","name":"Biais de négativité","cat":"biais","tagline":"Le négatif pèse plus lourd que le positif.","definition":"Les informations négatives ont un impact psychologique disproportionné par rapport aux informations positives de même intensité.","auteur":"Baumeister et al. (2001)","impact":"Un commentaire négatif pèse plus que dix positifs. Impact sur l'estime de soi, les évaluations.","exemples":["Se souvenir d'une critique plutôt que de cinq compliments","Un avis négatif annule plusieurs avis positifs","Les mauvaises nouvelles dominent l'attention"],"debiasing":["Ratio 3:1 positif/négatif pour compenser","Journal de gratitude"]},
+        {"id":"b_auto_complaisance","name":"Biais d'auto-complaisance","cat":"biais","tagline":"Succès = moi, échec = les autres.","definition":"Attribuer ses succès à des facteurs internes (talent, effort) et ses échecs à des facteurs externes (chance, circonstances).","auteur":"Miller & Ross (1975)","impact":"Empêche l'apprentissage de l'échec, crée des conflits d'attribution dans les équipes.","exemples":["'J'ai réussi grâce à mon travail' vs 'J'ai échoué à cause du prof'","Un manager : succès = leadership, échecs = marché"],"debiasing":["Analyser les échecs avec la même rigueur que les succès","Feedback 360°"]},
