+@app.get("/api/statistics/formulas/{test_id}")
+def get_statistical_formula(test_id: str):
+    """Retourne la formule et les détails d'un test statistique."""
+    formulas = {
+        "ttest_indep": {
+            "name": "T-test pour échantillons indépendants",
+            "formula": "t = (M₁ - M₂) / √(s²p(1/n₁ + 1/n₂))",
+            "where": "s²p = ((n₁-1)s₁² + (n₂-1)s₂²) / (n₁+n₂-2)",
+            "df": "n₁ + n₂ - 2",
+            "effect_size": "d = (M₁ - M₂) / s_p",
+            "interpretation": "d = 0.2 (petit), 0.5 (moyen), 0.8 (grand)"
+        },
+        "ttest_paired": {
+            "name": "T-test pour échantillons appariés",
+            "formula": "t = M_d / (s_d / √n)",
+            "where": "M_d = moyenne des différences, s_d = écart-type des différences",
+            "df": "n - 1",
+            "effect_size": "d = M_d / s_d",
+            "interpretation": "d = 0.2 (petit), 0.5 (moyen), 0.8 (grand)"
+        },
+        "anova_oneway": {
+            "name": "ANOVA à un facteur",
+            "formula": "F = MS_between / MS_within",
+            "where": "MS_between = SS_between / df_between, MS_within = SS_within / df_within",
+            "df": "df_between = k-1, df_within = N-k",
+            "effect_size": "η² = SS_between / SS_total",
+            "interpretation": "η² = 0.01 (petit), 0.06 (moyen), 0.14 (grand)"
+        },
+        "pearson": {
+            "name": "Corrélation de Pearson",
+            "formula": "r = Σ((X-Mx)(Y-My)) / √(Σ(X-Mx)² × Σ(Y-My)²)",
+            "where": "Mx, My = moyennes de X et Y",
+            "df": "n - 2",
+            "effect_size": "r (coefficient de corrélation)",
+            "interpretation": "r = 0.1 (petit), 0.3 (moyen), 0.5 (grand)"
+        },
+        "chisquare": {
+            "name": "Test du Chi-carré",
+            "formula": "χ² = Σ((O-E)² / E)",
+            "where": "O = effectif observé, E = effectif attendu",
+            "df": "(lignes-1) × (colonnes-1)",
+            "effect_size": "V de Cramer = √(χ² / (n × min(lignes-1, colonnes-1)))",
+            "interpretation": "V = 0.1 (petit), 0.3 (moyen), 0.5 (grand)"
+        }
+    }
+    
+    if test_id not in formulas:
+        raise HTTPException(status_code=404, detail="Formule non trouvée")
+    
+    return formulas[test_id]
