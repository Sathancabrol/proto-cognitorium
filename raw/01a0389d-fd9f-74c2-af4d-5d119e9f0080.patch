+@app.get("/api/concept-detail/{concept_id}")
+def get_concept_detail_api(concept_id: str):
+    detail = get_concept_detail(concept_id)
+    if detail:
+        return detail
+    card = get_bias_card(concept_id)
+    if card:
+        return {
+            "type": "bias",
+            "history": card.get("history", ""),
+            "mechanisms": card.get("mechanisms", []),
+            "key_experiments": card.get("key_experiments", []),
