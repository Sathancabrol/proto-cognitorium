{
  "meta": {
    "document": "Cognitorium — Document de Paramétrage",
    "version": "1.0",
    "date": "2026-08-07",
    "applicabilite": "MVP-0 à MVP-6",
    "format": "Ce fichier est la source de vérité. Tout hardcodage interdit."
  },
  "scoring": {
    "description": "Score = Niveau_estimé × Confiance",
    "echelle_niveau": {
      "min": 0,
      "max": 100,
      "type": "integer"
    },
    "poids_preuve": {
      "auto": 0.3,
      "diplome": 0.9,
      "projet": 0.8,
      "exp": 0.7,
      "attest": 0.6
    },
    "calcul_niveau_estime": {
      "formule": "moyenne_pondérée",
      "expression": "SUM(niveau_i × poids_i) / SUM(poids_i)",
      "arrondi": "1 décimale",
      "exemple": "Diplôme(80×0.9) + Auto-éval(90×0.3) = 82.5"
    },
    "confiance": {
      "sans_preuve": 0.2,
      "avec_preuve": "calculée dynamiquement via poids max atteint",
      "plafond_niveau_sans_preuve": 40,
      "message_utilisateur": "Aucune preuve détectée — niveau plafonné à 40 et confiance réduite à 0.2. Ajoutez un diplôme, une expérience ou une attestation pour débloquer le scoring complet."
    },
    "affichage_ui": {
      "formule_visible": true,
      "poids_visibles": true,
      "sources_listees": true
    }
  },
  "decay_engine": {
    "description": "Niveau_actuel = Niveau_historique × exp(-λ × Δt)",
    "formule": "Niveau_actuel = Niveau_historique * exp(-lambda * delta_annees)",
    "delta_t_unite": "années (float, précision jour)",
    "lambda": {
      "technique": 0.12,
      "transversal": 0.06,
      "langue": 0.08
    },
    "lambda_configurables_ui": true,
    "calcul_trigger": [
      "ouverture_application",
      "modification_profil",
      "consultation_competence",
      "background_timer_objectifs_actifs"
    ],
    "affichage": {
      "niveau_historique": true,
      "niveau_actuel": true,
      "potentiel_recuperation": true,
      "courbe_visuelle": "mini-graphique temporel dans la sidebar compétence"
    },
    "rappels": {
      "condition": "competence en declin (niveau_actuel < niveau_historique * 0.8) ET liée à un objectif actif",
      "action": "notification UI non-bloquante + badge orange sur le projet concerné"
    }
  },
  "matching_rome": {
    "description": "TF-IDF + Similarité Cosinus entre vecteur profil et vecteurs ROME",
    "champs_profil_vectorises": [
      "competences.name",
      "competences.contexte_nom",
      "parcours_event.raw_text"
    ],
    "champs_rome_vectorises": [
      "competences_savoirs",
      "competences_savoir_faire"
    ],
    "seuils_categorisation": {
